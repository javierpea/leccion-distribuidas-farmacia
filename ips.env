# =====================================================================
#  ÚNICO ARCHIVO DE IPs Y PUERTOS DEL SISTEMA
#
#  Si cambian de red, SOLO se modifica este archivo y luego se ejecuta:
#
#      python aplicar_ips.py          (Windows)
#      python3 aplicar_ips.py         (VM Ubuntu)
#
#  El script regenera: nginx/nginx.conf, nginx/docker-compose.yml,
#  keepalived/*.conf, keepalived/check_nginx.sh y
#  farmacia_app/lib/config_red.dart.  La API Flask lee este archivo
#  directamente (backend/config.py), no hay que copiar nada.
#
#  Formato: NOMBRE=valor   (sin espacios; comentarios en su propia línea)
# =====================================================================

# --- Servidores (cada uno con su VM Ubuntu: NGINX + Keepalived) ---
# MASTER
IP_SERVER1=10.79.20.38
# ESCLAVO 1
IP_SERVER2=10.79.16.19
# ESCLAVO 2
IP_SERVER3=10.79.20.2

# --- IP virtual que maneja Keepalived (la única que conoce la app) ---
IP_VIRTUAL=10.79.7.200
MASCARA=22
# Interfaz de red de la VM (ver con: ip a)
INTERFAZ_VM=enp0s3
# Puerto donde NGINX atiende en cada VM (la app usa http://IP_VIRTUAL:PUERTO_NGINX)
PUERTO_NGINX=90

# --- Las dos APIs Flask (dos entornos independientes) ---
# Entorno 1: el cliente
IP_API1=10.79.20.22
PUERTO_API1=5000
# Entorno 2: el Windows del Server 1
IP_API2=10.79.20.38
PUERTO_API2=5001

# --- Base de datos (SQL Server Express del cliente) ---
IP_BD=10.79.20.22
PUERTO_BD=1433

# --- Red desde la que se permiten conexiones (reglas de firewall) ---
RED_PERMITIDA=10.79.4.0/22
