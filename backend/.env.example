# Copiar como .env en cada entorno de la API.
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_DATABASE=AppDistribuidas_2026_DB

# --- Entorno 1: CLIENTE 10.79.7.180 (API :5000) - SQL Express local, autenticación de Windows ---
DB_SERVER=localhost\SQLEXPRESS

# --- Entorno 2: SERVER 1 10.79.5.86 (API :5001) - BD del cliente por red ---
# DB_SERVER=10.79.7.180,1433
# DB_UID=farmacia_app
# DB_PWD=Farmacia2026*

# Solo para la demo: 1 = apaga los controles del backend (la BD sigue controlando)
DESACTIVAR_VALIDACION_BACKEND=0
