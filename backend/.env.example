# =====================================================================
#  Copiar como .env en cada entorno de la API:   copy .env.example .env
#  Las IPs NO se escriben aquí: se toman de ../ips.env  (${IP_BD}, ${PUERTO_BD})
# =====================================================================
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_DATABASE=AppDistribuidas_2026_DB

# --- Entorno 1 (equipo de la BD, API :5000): SQL Express local, autenticación de Windows ---
DB_SERVER=localhost\SQLEXPRESS

# --- Entorno 2 (otro equipo, API :5001): comentar la línea de arriba y descomentar estas ---
# DB_SERVER=${IP_BD},${PUERTO_BD}
# DB_UID=farmacia_app
# DB_PWD=Farmacia2026*

# --- Sesión: minutos que dura el token (Unidad 3 usa 5) ---
TOKEN_MINUTOS=5

# --- Login con Google y Facebook (opcional; vacío = la app oculta el botón) ---
# Google Cloud Console -> Credenciales -> ID de cliente OAuth tipo "App de escritorio"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# developers.facebook.com -> Mi app -> Inicio de sesión con Facebook
#   URI de redireccionamiento OAuth válido: http://localhost:8765/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Debe ser IGUAL en los dos entornos y en la consola de Google/Facebook
OAUTH_REDIRECT_URI=http://localhost:8765/callback

# Solo para la demo: 1 = apaga los controles del backend (la BD sigue controlando)
DESACTIVAR_VALIDACION_BACKEND=0
